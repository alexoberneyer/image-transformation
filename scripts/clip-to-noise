#!/usr/bin/env bash
#
# Turns the image on the clipboard into keyed noise.
#
# The noise is written to a file and the clipboard is left holding a *reference*
# to that file, so pasting into a chat or a document attaches the PNG losslessly
# instead of inlining a bitmap the receiving app is free to re-encode. `--bitmap`
# puts the pixels on the clipboard instead, for the cases where an inline paste
# is what you actually want.
#
# With no key configured - no $IMAGE_NOISE_KEY and nothing in the keychain - a
# random one is minted for this image alone, printed, and stored under its
# key-id so clip-from-noise can find it again.
#
# `-r` seals the image to somebody's ssh-ed25519 public key instead. Then there
# is no shared key at all: nothing is minted, nothing is stored, nothing has to
# be handed over, and only the holder of the matching private key can open it -
# including you, who cannot. A recipient is the key itself, a path to it, or a
# short name filed under $IMAGE_NOISE_RECIPIENTS_DIR.
#
# Usage: clip-to-noise [--bitmap] [-r <recipient>]... [-o <path>]

source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

bitmap=0
out=""
recipients=()
while [ $# -gt 0 ]; do
    case "$1" in
        --bitmap) bitmap=1 ;;
        -r|--recipient) recipients+=("${2:?-r needs a recipient}"); shift ;;
        -o|--output) out="${2:?-o needs a path}"; shift ;;
        -h|--help) sed -n '2,23p' "$0" | cut -c3-; exit 0 ;;
        *) echo "${0##*/}: unknown option $1" >&2; exit 1 ;;
    esac
    shift
done

# A standing set of recipients, so the hotkey needs no argument at all.
if [ ${#recipients[@]} -eq 0 ] && [ -n "${IMAGE_NOISE_RECIPIENTS:-}" ]; then
    read -ra recipients <<< "$IMAGE_NOISE_RECIPIENTS"
fi

require_tools

# Either seal to public keys or fall back to the shared-key path. The two are
# mutually exclusive by construction: `to-noise` refuses both at once.
sealed=0
key_flags=()
if [ ${#recipients[@]} -gt 0 ]; then
    sealed=1
    minted=0
    for who in "${recipients[@]}"; do
        key_flags+=(--recipient "$(resolve_recipient "$who")")
    done
else
    load_or_mint_key
    key_flags=(--key-env "$key_var")
fi

# to-noise reports the key-id and the fingerprints on stderr. They are held in a
# file only long enough to read the key-id back out, then printed unchanged.
# Nothing in there is secret.
report_file=$(mktemp)
trap 'rm -f "$report_file"' EXIT

# Whether the noise ends up carrying its own key-id. A bitmap has no name to
# put one in, and a path given with -o belongs to the caller.
id_in_name=0

# `--normalize` forces the clipboard image to 8-bit RGB with no alpha and no
# colour profile. Screenshots and images copied out of a browser arrive in
# shapes the transform rejects outright, and it is safe here: whatever pixels
# come out of it are simply what gets encrypted.
if [ "$bitmap" = 1 ]; then
    # Nothing touches the disk in this mode.
    "$bin_dir/clipimg" paste --normalize \
        | "$bin_dir/to-noise" "${key_flags[@]}" - -o - 2>"$report_file" \
        | "$bin_dir/clipimg" copy -
    cat "$report_file" >&2
    key_id=$(sed -n 's/^key-id \([0-9a-f]\{1,\}\)$/\1/p' "$report_file")
    echo "clipboard now holds the noise as a bitmap" >&2
else
    if [ -z "$out" ]; then
        tmp=${TMPDIR:-/tmp}
        dir=${IMAGE_NOISE_DIR:-${tmp%/}/image-noise}
        mkdir -p "$dir"
        stamp=$(date +%Y%m%d-%H%M%S)
        if [ "$sealed" = 1 ]; then
            # A sealed name carries no key-id, so it needs something else to keep
            # two images made in the same second off the same path. Four random
            # bytes, and short enough not to be mistaken for the 16-hex key-id
            # the inverse looks for.
            out="$dir/noise-$stamp-$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n').png"
        else
            out="$dir/noise-$stamp.png"
        fi
        chose_name=1
    else
        chose_name=0
    fi

    # Only the noise is ever written out; the original pixels stay in the pipe.
    "$bin_dir/clipimg" paste --normalize \
        | "$bin_dir/to-noise" "${key_flags[@]}" - -o "$out" 2>"$report_file"
    key_id=$(sed -n 's/^key-id \([0-9a-f]\{1,\}\)$/\1/p' "$report_file")

    # The key-id goes in the name of any file we named ourselves. It gives away
    # nothing, and it is what lets clip-from-noise pick the right key out of the
    # keychain from a pasted file reference alone. The report is printed only
    # afterwards, with the name to-noise was handed patched up to the one that
    # actually exists.
    # A sealed image has no stored key to look up, so its key-id would name
    # nothing. The name stays plain.
    if [ "$chose_name" = 1 ] && [ -n "$key_id" ] && [ "$sealed" = 0 ]; then
        with_id="${out%.png}-$key_id.png"
        mv -- "$out" "$with_id"
        sed -i '' "s|${out##*/}|${with_id##*/}|" "$report_file"
        out=$with_id
        id_in_name=1
    fi
    cat "$report_file" >&2

    "$bin_dir/clipimg" copy-file "$out"
    echo "clipboard now holds a reference to $out" >&2
fi

if [ "$sealed" = 1 ]; then
    echo >&2
    if [ ${#recipients[@]} -eq 1 ]; then
        echo "sealed to ${recipients[0]}. Send the file; there is no key to send" >&2
        echo "with it, and nothing you can do to open it again yourself." >&2
    else
        echo "sealed to ${#recipients[@]} recipients: ${recipients[*]}." >&2
        echo "Send the file; there is no key to send with it, and nothing you can" >&2
        echo "do to open it again yourself." >&2
    fi
fi

if [ "$minted" = 1 ]; then
    echo >&2
    echo "no key was configured, so this image got a random one:" >&2
    echo >&2
    echo "  ${!key_var}" >&2
    echo >&2
    if [ -n "$key_id" ] && remember_key "$key_id"; then
        if [ "$id_in_name" = 1 ]; then
            echo "Saved to the keychain, and the noise filename carries the key-id, so" >&2
            echo "clip-from-noise will find it again on its own. Copy the key above to" >&2
            echo "send this image to anyone else - they cannot read your keychain." >&2
        else
            echo "Saved to the keychain under key-id $key_id, but this noise carries no" >&2
            echo "name to read that id off, so hand the key back yourself:" >&2
            echo "  IMAGE_NOISE_KEY=<the key above> clip-from-noise" >&2
        fi
    else
        echo "It could NOT be saved to the keychain. Copy it now: without it the" >&2
        echo "image is unrecoverable." >&2
    fi
fi
