#!/usr/bin/env bash
#
# Rebuilds the "Seal Image to Noise" Raycast command from its template, with
# the recipient dropdown filled in from the recipients directory.
#
# A Raycast dropdown is a static list inside the script file - Raycast reads it
# before the script ever runs, so there is no way to populate one at run time.
# That means the list of people you send images to has to be written into the
# file, which is why git tracks `scripts/templates/image-to-noise-sealed.sh.in`
# and ignores what comes out of it. Your recipients stay on your machine.
#
# Run this after saving a key. Forgetting is never blocking: the same name still
# works typed into the command's text field.
#
# Usage: refresh-recipients

source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

mkdir -p "$recipients_dir"
render_sealed_command || exit 1

echo "wrote ${sealed_command#"$repo_root/"}"
if [ ${#recipient_names[@]} -gt 0 ]; then
    echo "dropdown now offers: ${recipient_names[*]}"
else
    echo "no ssh-ed25519 keys in $recipients_dir, so the dropdown is empty."
    echo "Save one and run this again:"
    echo "  cp their_key.pub $recipients_dir/alex.pub"
fi
if [ ${#recipient_skipped[@]} -gt 0 ]; then
    echo "skipped (not ssh-ed25519): ${recipient_skipped[*]}"
fi
