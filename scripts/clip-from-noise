#!/usr/bin/env bash
#
# Reconstructs the original image from the noise on the clipboard and leaves the
# result on the clipboard.
#
# The noise is never normalized on the way in: redrawing it through a colour
# space would rewrite the exact bytes the inverse depends on. If the clipboard
# holds a file reference, those bytes are read straight off disk, which is the
# only path guaranteed to be lossless - a noise image that has been pasted into
# an app and copied back out has usually been re-encoded and cannot be restored.
#
# `-i` reads the noise from a path instead, for when the clipboard is needed for
# something else. It is the same bytes off the same disk; only the route differs.
#
# A file written by clip-to-noise carries its key-id in the name, which is
# enough to find the key it was made with in the keychain, whichever way it
# arrives.
#
# Usage: clip-from-noise [-i <path>] [-o <path>]

source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

in_path=""
out=""
while [ $# -gt 0 ]; do
    case "$1" in
        -i|--input) in_path="${2:?-i needs a path}"; shift ;;
        -o|--output) out="${2:?-o needs a path}"; shift ;;
        -h|--help) sed -n '2,19p' "$0" | cut -c3-; exit 0 ;;
        *) echo "${0##*/}: unknown option $1" >&2; exit 1 ;;
    esac
    shift
done

require_tools

# Where the noise comes from, and the name a key-id is read off. A path given
# with -i is read straight off disk; the clipboard matches that only when it
# holds a file reference, which clipimg also reads off disk.
if [ -n "$in_path" ]; then
    [ -f "$in_path" ] || { echo "${0##*/}: no such file: $in_path" >&2; exit 1; }
    src=$in_path
    read_noise() { cat -- "$in_path"; }
else
    src=$("$bin_dir/clipimg" path 2>/dev/null) || src=""
    read_noise() { "$bin_dir/clipimg" paste; }
fi

# The trailing hex group in a clip-to-noise filename is the key-id of the key
# that made it. Absent (a bitmap, a renamed file, noise from somewhere else) it
# stays empty and the key is resolved the same way it always was.
key_id=$(printf '%s\n' "${src##*/}" | sed -n 's/.*-\([0-9a-f]\{16\}\)\.png$/\1/p')

load_key_for_id "$key_id"

if [ -n "$out" ]; then
    read_noise | "$bin_dir/from-noise" --key-env "$key_var" - -o "$out"
    "$bin_dir/clipimg" copy "$out"
    echo "clipboard now holds the restored image (also at $out)" >&2
else
    # The restored image is the plaintext, so it goes straight to the clipboard
    # without ever being written to disk.
    read_noise \
        | "$bin_dir/from-noise" --key-env "$key_var" - -o - \
        | "$bin_dir/clipimg" copy -
    echo "clipboard now holds the restored image" >&2
fi

echo "compare the fingerprints above: matching 'noise' lines mean the noise" >&2
echo "arrived intact, and 'restored' matching the original 'source' means the" >&2
echo "key was right." >&2
